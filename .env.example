# Root-level example values for scripts and shared defaults.
# Copy to a real .env only on the server; never commit secrets.

# LAN used by system/docker-lan-filter.sh
LAN_SUBNET=10.0.0.0/24

# ntfy topic subscribed on the phone
NTFY_TOPIC=homelab-alerts
NTFY_URL=http://127.0.0.1:8093/homelab-alerts

# Deploy user (non-root) that owns /opt/stacks
DEPLOY_USER=deploy
