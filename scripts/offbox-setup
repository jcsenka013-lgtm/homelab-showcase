#!/usr/bin/env bash
# Prepare a second Linux host as the off-box copy of nightly backups.
# Run from the homelab server after `sudo scripts/server-prep backup`:
#   OFFBOX_SSH=user@offbox-host scripts/offbox-setup
#
# On the remote host it:
#   - Ensures /srv/offbox exists (you format/mount the backup disk yourself;
#     this showcase does not ship disk hardware IDs or wipe a specific model)
#   - Adds an "offbox" user whose only power is rrsync -wo -no-del into
#     /srv/offbox: the server key can add files but cannot read or delete them
#   - Restricts sshd so offbox may connect only from the server addresses you set
#   - Prunes copies older than 60 days daily on the receiver
# Safe to re-run.
set -euo pipefail

PUB=/etc/server-backup/offbox.pub
[ -r "$PUB" ] || { echo "$PUB missing: run 'sudo scripts/server-prep backup' first" >&2; exit 1; }

host=${OFFBOX_SSH:?set OFFBOX_SSH=user@offbox-host}
# Placeholder allow-list for the offbox SSH user (LAN + mesh of the server).
ALLOW_FROM=${OFFBOX_ALLOW_FROM:-10.0.0.10,server.example.ts.net}

echo "-> $host"

ssh "$host" 'cat > /tmp/offbox-setup.sh' <<'REMOTE'
set -euo pipefail
pub=$1
allow_from=$2
KEEP_DAYS=60

if ! mountpoint -q /srv/offbox; then
    echo "/srv/offbox is not mounted."
    echo "Format a dedicated disk, label it offbox, add it to fstab with nofail, then re-run."
    exit 1
fi

echo "== offbox user (rrsync, write-only, no deletes)"
id offbox >/dev/null 2>&1 || useradd --system --home-dir /var/lib/offbox --create-home --shell /bin/sh offbox
install -d -o offbox -g offbox -m 700 /srv/offbox/snapshots /srv/offbox/immich
chown offbox:offbox /srv/offbox && chmod 700 /srv/offbox
install -d -o offbox -g offbox -m 700 /var/lib/offbox/.ssh
echo "command=\"/usr/bin/rrsync -wo -no-del /srv/offbox\",restrict $pub" > /var/lib/offbox/.ssh/authorized_keys
chown offbox:offbox /var/lib/offbox/.ssh/authorized_keys && chmod 600 /var/lib/offbox/.ssh/authorized_keys

# AllowUsers entries are additive; restrict offbox to the server addresses only.
{
  echo "# Generated by offbox-setup — server LAN + mesh placeholders"
  IFS=',' read -ra addrs <<< "$allow_from"
  for a in "${addrs[@]}"; do
    a=$(echo "$a" | tr -d ' ')
    [ -n "$a" ] && echo "AllowUsers offbox@$a"
  done
} > /etc/ssh/sshd_config.d/60-offbox.conf
sshd -t
systemctl try-reload-or-restart ssh

echo "== prune copies older than $KEEP_DAYS days (daily)"
cat > /etc/cron.daily/offbox-prune <<EOF
#!/bin/sh
find /srv/offbox/snapshots -mindepth 1 -maxdepth 1 -type d -mtime +$KEEP_DAYS -exec rm -rf {} +
find /srv/offbox/immich -name 'immich-*.sql.gz' -mtime +$KEEP_DAYS -delete
EOF
chmod 755 /etc/cron.daily/offbox-prune

df -h /srv/offbox
REMOTE

ssh -t "$host" "sudo bash /tmp/offbox-setup.sh '$(cat "$PUB")' '$ALLOW_FROM'; rc=\$?; rm -f /tmp/offbox-setup.sh; exit \$rc"
